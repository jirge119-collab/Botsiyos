# Copia este archivo a .env y rellena tus valores.
# Puedes obtenerlos en my.telegram.org
API_ID=1234567
API_HASH="your_api_hash_here"

# Obtén este token de @BotFather en Telegram
BOT_TOKEN="your_bot_token_here"

# El ID del canal donde el bot enviará los registros (logs).
# Debe empezar con -100 y ser el ID de un canal público o privado.
CHANNEL_LOGS="-1001234567890"
